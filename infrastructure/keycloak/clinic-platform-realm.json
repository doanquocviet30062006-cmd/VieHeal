{
  "realm": "clinic-platform",
  "enabled": true,
  "displayName": "Clinic Platform",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "clients": [
    {
      "clientId": "vieheal-android",
      "name": "VieHeal Android",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "com.vieheal.mobile://oauth2redirect/callback",
        "com.vieheal.mobile://logout/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.vieheal.mobile://logout/callback"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ]
}
